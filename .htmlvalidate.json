{
  "extends": ["html-validate:recommended"],
  "rules": {
    "attr-quotes": "off",
    "attribute-boolean-style": "off",
    "attribute-empty-style": "off",
    "doctype-style": "off",
    "element-permitted-content": "off",
    "element-required-content": "off",
    "long-title": "off",
    "no-inline-style": "off",
    "no-raw-characters": "off",
    "prefer-native-element": "off",
    "require-sri": "off",
    "valid-id": "off",
    "wcag/h30": "off",
    "wcag/h32": "off",
    "wcag/h36": "off",
    "wcag/h37": "off",
    "wcag/h63": "off",
    "wcag/h67": "off",
    "wcag/h71": "off"
  }
}
